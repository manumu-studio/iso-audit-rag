# iso-audit-rag environment variables
# Copy this file to .env and fill in real values for local development.

# --- Database ---
# Local Postgres + pgvector via docker compose (see docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iso_audit

# --- API keys (used in later packets) ---
# OpenAI is used for embeddings (text-embedding-3-small).
OPENAI_API_KEY=
# Anthropic is used for answer generation (claude-sonnet-4-6).
ANTHROPIC_API_KEY=

# --- Runtime ---
# One of: dev | prod
ENVIRONMENT=dev
# Standard Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
