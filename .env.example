# iso-audit-rag — environment variables template (copy to `.env`; never commit real secrets).

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Postgres connection URL (Neon in production). Must include TLS for Neon.
#
# Production (replace user, password, host, and DB name):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/iso_audit?sslmode=require
#
# Local (Docker Postgres):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iso_audit

# -----------------------------------------------------------------------------
# Embeddings (OpenAI)
# -----------------------------------------------------------------------------
# Required for ingestion and retrieval embedding calls.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# LLM (Anthropic)
# -----------------------------------------------------------------------------
# Required for grounded answer generation.
ANTHROPIC_API_KEY=
# Model id passed through to Anthropic when the application supports overriding the default (optional).
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# One of: dev | prod
ENVIRONMENT=dev
# Standard Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
